# Database (PostgreSQL — richiesto)
# Lo schema viene creato/aggiornato automaticamente all'avvio del server.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Password del pannello admin — OBBLIGATORIA, nessun valore di default.
# Se manca, il login admin è disabilitato.
ADMIN_PASSWORD=

# Chiave segreta per firmare i login admin (stringa lunga e casuale).
# Se manca, ne viene generata una a ogni avvio e gli admin devono rifare login dopo un riavvio.
ADMIN_TOKEN=

# (Facoltativa) Cloudinary per le iscrizioni con foto dei partecipanti.
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# (Console Cloudinary → Settings → API Keys → "API environment variable").
# Se manca, la funzione "Iscrivi il tuo costume" resta nascosta.
CLOUDINARY_URL=

# Server
PORT=8080
NODE_ENV=production

# (Opzionale) Percorso assoluto alla cartella dei file statici del frontend.
# Di default: artifacts/costume-vote/dist/public relativo al bundle dell'API.
# STATIC_DIR=/app/artifacts/costume-vote/dist/public
